{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sites Config",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/Site"
  },
  "$defs": {
    "Site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "description": "Primary URL of the site (e.g. 'google.com')",
          "type": "string",
          "format": "uri"
        },
        "query": {
          "description": "Query path to search the site (e.g., 'search?q=')",
          "oneOf": [{ "$ref": "#/$defs/QueryObject" }, { "type": "string" }]
        },
        "default": {
          "type": "boolean",
          "description": "If true, this site is considered a default option."
        },
        "alias": {
          "$ref": "base.json#/$defs/alias",
          "description": "One or more aliases for the site."
        },
        "delimiter": {
          "description": "A character or string used to separate search terms.",
          "type": "string"
        },
        "resources": {
          "description": "Resource definitions for specific parts of the site. Supports deep, nested structures.",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "base.json#/$defs/NestedStringObject" },
              { "type": "string" }
            ]
          }
        }
      }
    },
    "QueryObject": {
      "description": "Object describing query path for the site. Supports deep, nested structures.",
      "type": "object",
      "properties": {
        "main": {
          "description": "Main query path for the site.",
          "type": "string"
        }
      },
      "additionalProperties": {
        "description": "Additional query path for the site.",
        "oneOf": [
          { "$ref": "base.json#/$defs/NestedStringObject" },
          { "type": "string" }
        ]
      },
      "required": ["main"]
    }
  }
}
