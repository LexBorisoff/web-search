{
  "name": "@lexjs/web",
  "version": "0.0.0-semantically-released",
  "description": "CLI for making browser web searches from the shell",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepack": "npm run build",
    "prebuild": "npm run ci && rimraf ./dist",
    "build": "npm run compile && npm run import-alias",
    "ci": "npm run check:style && npm run check:build",
    "check:build": "npm run compile -- --noEmit",
    "check:style": "npm run check:format && npm run check:lint",
    "check:format": "prettier --check \"*.{js,cjs,mjs,ts,cts,mts}\" \"src/**/*.ts\"",
    "check:lint": "eslint \"src/**/*.{js,ts}\"",
    "compile": "tsc -p tsconfig.json",
    "import-alias": "tsc-alias -p tsconfig.json",
    "style": "npm run format && npm run lint",
    "format": "prettier --write \"*.{js,cjs,mjs,ts,cts,mts}\" \"src/**/*.ts\"",
    "lint": "npm run check:lint -- --fix",
    "prepare": "husky"
  },
  "author": "Lex Borisoff <lex@borisoff.dev>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LexBorisoff/web-search.git"
  },
  "homepage": "https://github.com/LexBorisoff/web-search/tree/main#readme",
  "bugs": {
    "url": "https://github.com/LexBorisoff/web-search/issues"
  },
  "bin": {
    "create-lexjs-web": "dist/create-app/main.js"
  },
  "keywords": [
    "cli",
    "search",
    "websearch",
    "web-search",
    "search-web",
    "site-search",
    "search-engine",
    "browser-query",
    "web-query",
    "browser",
    "google",
    "chrome",
    "firefox",
    "edge",
    "brave",
    "sites"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=16.10.0"
  },
  "dependencies": {
    "@lexjs/filetree": "^3.0.0",
    "@lexjs/prompts": "^1.2.1",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "execa": "^9.6.1",
    "js-yaml": "^5.2.1",
    "open": "^10.2.0",
    "type-fest": "^4.15.0",
    "yargs": "^17.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@lexjs/eslint": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/yargs": "^17.0.24",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.3",
    "tsc-alias": "^1.8.10",
    "typescript": "^6.0.3"
  }
}
