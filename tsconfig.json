{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "paths": {
      "@actions/*": ["./src/actions/*"],
      "@api/*": ["./src/api/*"],
      "@app-types/*": ["./src/types/*"],
      "@command/*": ["./src/command/*"],
      "@config/*": ["./src/config/*"],
      "@data/*": ["./src/data/*"],
      "@helpers/*": ["./src/helpers/*"],
      "@query/*": ["./src/query/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src"]
}
